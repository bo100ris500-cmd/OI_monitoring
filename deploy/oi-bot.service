# OI Telegram Bot — прод на Linux VPS
# Актуальный путь на сервере пользователя: /root/OI_monitoring
#
# sudo cp /root/OI_monitoring/deploy/oi-bot.service /etc/systemd/system/oi-bot.service
# sudo systemctl daemon-reload && sudo systemctl enable --now oi-bot
# journalctl -u oi-bot -f

[Unit]
Description=OI Telegram monitoring bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/OI_monitoring
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/root/OI_monitoring/.env
ExecStart=/root/OI_monitoring/venv/bin/python /root/OI_monitoring/main.py
Restart=always
RestartSec=5
TimeoutStopSec=90
KillMode=mixed
MemoryMax=900M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
